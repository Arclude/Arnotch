[Unit]
Description=notch, a Dynamic-Island-style assistant
Documentation=https://github.com/Arclude/linux-ai
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/notch
Restart=on-failure
RestartSec=2
Slice=app.slice

[Install]
WantedBy=graphical-session.target
